---
import Base from '../../layouts/Base.astro';
import ContactPage from '../../components/ContactPage.astro';

const title = 'تواصل معنا — نواة';
const description = 'أخبرنا بما تريد بناءه أو إصلاحه أو ربطه. تواصل مع نواة مباشرة عبر البريد أو الهاتف أو واتساب — ردّ شخصي على كل استفسار.';
---

<Base locale="ar" title={title} description={description} path="/ar/contact">
  <ContactPage locale="ar" />
</Base>
