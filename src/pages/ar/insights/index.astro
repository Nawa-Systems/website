---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';

const entries = (await getCollection('insights-ar', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const posts = entries.map((p) => ({ id: p.id, title: p.data.title, description: p.data.description }));

const title = 'مقالات — نواة';
const description = 'ملاحظات ومقالات هندسية من نواة — المعمارية والتكامل والأتمتة من عمل حقيقي.';
---

<Base locale="ar" title={title} description={description} path="/ar/insights">
  <InsightsIndex locale="ar" posts={posts} />
</Base>
