---
import Base from '../../layouts/Base.astro';
import FounderSection from '../../components/FounderSection.astro';
import { getAboutCopy } from '../../data/aboutCopy';

const copy = getAboutCopy('ar');
const title = 'من نحن — نواة';
---

<Base locale="ar" title={title} description={copy.intro} path="/ar/about">
  <div class="container about-page">
    <header class="page-header">
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <section class="about-block">
      <h2>{copy.purposeTitle}</h2>
      <p>{copy.purpose}</p>
    </section>

    <section class="about-block">
      <h2>{copy.missionTitle}</h2>
      <p>{copy.mission}</p>
    </section>

    <section class="about-block">
      <h2>{copy.valuesTitle}</h2>
      <dl class="values-grid">
        {copy.values.map((v) => (
          <div>
            <dt>{v.name}</dt>
            <dd>{v.meaning}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="about-block">
      <h2>{copy.placeTitle}</h2>
      <p>{copy.place}</p>
    </section>

    <section class="about-block">
      <h2>{copy.governanceTitle}</h2>
      <p>{copy.governance}</p>
    </section>

    <section class="about-block">
      <FounderSection locale="ar" />
    </section>
  </div>
</Base>

<style>
  .about-page {
    padding-block: var(--space-6) var(--space-8);
  }
  .page-header {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-6);
  }
  .page-header p {
    color: var(--color-secondary-text);
    font-size: var(--text-lg);
  }
  .about-block {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    max-width: var(--max-width-prose);
  }
  .about-block h2 {
    font-size: var(--text-xl);
    color: var(--color-burgundy);
    margin-bottom: var(--space-3);
  }
  .about-block:has(.founder) {
    max-width: none;
  }
  .values-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin: 0;
  }
  .values-grid dt {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }
  .values-grid dd {
    margin: 0;
    color: var(--color-secondary-text);
    font-size: var(--text-sm);
  }
  @media (max-width: 640px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
