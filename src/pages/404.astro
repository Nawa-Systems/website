---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Nawa</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="page en" dir="ltr">
      <header class="nf-header">
        <div class="wrap nf-header-inner">
          <a href="/en" class="nf-brand" aria-label="Nawa — home">
            <Logo variant="primary" width={28} />
            <span>Nawa</span>
          </a>
        </div>
      </header>

      <main>
        <section class="nf">
          <div class="wrap grid12 nf-inner">
            <div class="nf-text">
              <p class="anno">HTTP 404 · route not found</p>
              <h1 class="t-h1">This page isn’t part of the system.</h1>
              <p class="t-lead">The link may be old or mistyped. Everything else is still connected.</p>
              <div class="nf-ctas">
                <a href="/en" class="btn btn-primary">Go to the homepage</a>
                <a href="/en/work" class="btn btn-secondary">View our work</a>
              </div>
              <p class="t-sm nf-ar"><a href="/ar" lang="ar" class="ar">الصفحة غير موجودة — العودة إلى الرئيسية</a></p>
            </div>
            <div class="nf-graphic" aria-hidden="true">
              <svg viewBox="0 0 420 300" width="100%" style="display:block">
                <path d="M60 150C90 150 90 110 120 110" fill="none" stroke="#A9ACAF" stroke-width="1.25"></path>
                <path d="M60 150C90 150 90 190 120 190" fill="none" stroke="#A9ACAF" stroke-width="1.25"></path>
                <path d="M172 110H230" stroke="#A9ACAF" stroke-width="1.25"></path>
                <path d="M172 190H248" stroke="#A9ACAF" stroke-width="1.25" stroke-dasharray="3 5"></path>
                <circle cx="60" cy="150" r="12" fill="#6E263C"></circle>
                <rect x="120" y="86" width="52" height="48" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
                <rect x="120" y="166" width="52" height="48" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
                <rect x="230" y="86" width="130" height="48" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
                <rect x="256" y="166" width="104" height="48" rx="8" fill="none" stroke="#B42318" stroke-width="1.25" stroke-dasharray="4 4"></rect>
                <circle cx="248" cy="190" r="3.5" fill="#fff" stroke="#B42318" stroke-width="1.25"></circle>
                <text x="270" y="195" font-size="12" fill="#B42318" style="font-family:'IBM Plex Mono',monospace">404</text>
                <text x="244" y="115" font-size="12" fill="#64686E" style="font-family:'IBM Plex Mono',monospace">/en</text>
              </svg>
            </div>
          </div>
        </section>
      </main>
    </div>

    <style>
      .nf-header { border-bottom: 1px solid var(--border); }
      .nf-header-inner { height: 72px; display: flex; align-items: center; }
      .nf-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--strong); font-size: 20px; font-weight: 600; }
      .nf { border-bottom: 1px solid var(--border); }
      .nf-inner { padding-top: 120px; padding-bottom: 120px; align-items: center; row-gap: 48px; }
      .nf-text { grid-column: 1 / span 6; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
      .nf-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
      .nf-ar { margin-top: 8px; }
      .nf-graphic { grid-column: 8 / span 5; }
      @media (max-width: 900px) {
        .nf-inner { padding-top: 72px; padding-bottom: 72px; }
        .nf-text, .nf-graphic { grid-column: 1 / -1; }
        .nf-graphic { max-width: 360px; }
      }
    </style>
  </body>
</html>
