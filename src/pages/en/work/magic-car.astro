---
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { getMagicCarCopy } from '../../../data/caseStudies/magicCarCopy';

const copy = getMagicCarCopy('en');
const title = `${copy.title} — Nawa`;
---

<Base locale="en" title={title} description={copy.summary} path="/en/work/magic-car">
  <CaseStudy slug="magic-car" {...copy} />
</Base>
