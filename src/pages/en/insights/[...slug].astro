---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights-en', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base locale="en" title={`${post.data.title} — Nawa`} description={post.data.description} path={`/en/insights/${post.id}`}>
  <article class="container insights-post">
    <h1>{post.data.title}</h1>
    <div class="insights-post__body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .insights-post {
    padding-block: var(--space-6) var(--space-8);
    max-width: var(--max-width-prose);
  }
  .insights-post h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-5);
  }
  .insights-post__body :global(p) {
    margin-bottom: var(--space-4);
  }
</style>
