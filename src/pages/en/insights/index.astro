---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import InsightsIndex from '../../../components/InsightsIndex.astro';

const entries = (await getCollection('insights-en', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const posts = entries.map((p) => ({ id: p.id, title: p.data.title, description: p.data.description }));

const title = 'Insights — Nawa';
const description = 'Engineering notes and articles from Nawa — architecture, integration and automation from real work.';
---

<Base locale="en" title={title} description={description} path="/en/insights">
  <InsightsIndex locale="en" posts={posts} />
</Base>
