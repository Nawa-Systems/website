---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/LegalPage.astro';
import { getLegalCopy } from '../../data/legalCopy';
const copy = getLegalCopy('en');
---

<Base locale="en" title={`${copy.privacyTitle} — Nawa`} description={copy.privacyIntro} path="/en/privacy">
  <LegalPage locale="en" which="privacy" title={copy.privacyTitle} intro={copy.privacyIntro} sections={copy.privacySections} />
</Base>
