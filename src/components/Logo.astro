---
// Nawa symbol — inline SVG, exact vector master geometry (viewBox 190 155 874 952).
// Two deep-charcoal architectural forms + a burgundy circular nucleus.
// Never stretched, rotated, mirrored or recolored outside the approved variants.
interface Props {
  variant?: 'primary' | 'charcoal' | 'white';
  width?: number;
  class?: string;
  title?: string;
}

const { variant = 'primary', width = 28, class: className, title } = Astro.props;
const height = Math.round(width * (952 / 874));

// primary = charcoal structure + burgundy nucleus; charcoal/white = single-ink.
const structure = variant === 'white' ? '#FAF9F7' : variant === 'charcoal' ? '#2A2C2F' : '#2A2C2F';
const nucleus = variant === 'white' ? '#FAF9F7' : variant === 'charcoal' ? '#2A2C2F' : '#6E263C';
---

<svg
  viewBox="190 155 874 952"
  width={width}
  height={height}
  class={`icon-brand ${className ?? ''}`}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title ?? undefined}
  style="display:block;flex:none"
>
  <path
    fill={structure}
    d="M281 450C274 450 269 457 269 466L269 771C269 811 292 841 329 869L536 1010C547 1017 561 1009 561 996L561 689C561 651 544 620 510 592L302 453C295 448 288 447 281 450Z"
