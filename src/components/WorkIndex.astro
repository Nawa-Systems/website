---
import { projects } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const heroDims: Record<string, { width: number; height: number }> = {
  rihab: { width: 2000, height: 1008 },
  'magic-car': { width: 369, height: 800 },
};
---

<section class="work-index container">
  {projects.map((project) => {
    const name = locale === 'ar' ? project.nameAr : project.nameEn;
    const ownership = locale === 'ar' ? project.ownershipLabelAr : project.ownershipLabelEn;
    const summary = locale === 'ar' ? project.summaryAr : project.summaryEn;
    const dims = heroDims[project.slug];
    return (
      <a class="work-card" href={`/${locale}/work/${project.slug}`}>
        <div class="work-card__image">
          <ResponsiveImage
            basePath={`/work/${project.slug}/${project.heroImage}`}
            alt={name}
            width={dims.width}
            height={dims.height}
          />
        </div>
        <div class="work-card__body">
          <span class="work-card__ownership">{ownership}</span>
          <h2>{name}</h2>
          <p>{summary}</p>
        </div>
      </a>
    );
  })}
</section>

<style>
  .work-index {
    padding-block: var(--space-7);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .work-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    transition: border-color var(--motion-fast) var(--ease-standard);
  }

  .work-card:hover {
    border-color: var(--color-burgundy);
  }

  .work-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-subtle-surface);
  }

  .work-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card__body {
    padding: var(--space-4);
  }

  .work-card__ownership {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-rust);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .work-card__body h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .work-card__body p {
    color: var(--color-secondary-text);
    font-size: var(--text-sm);
    margin: 0;
  }

  @media (max-width: 780px) {
    .work-index {
      grid-template-columns: 1fr;
    }
  }
</style>
