---
import ResponsiveImage from './ResponsiveImage.astro';
import type { Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isAr = locale === 'ar';
const L = (slug: string) => `/${locale}/${slug}`;
const arrow = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="dir-icon" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>`;

const t = isAr
  ? {
      label: 'الأعمال',
      title: 'أعمال تُقرأ كأدلّة هندسية، لا كمعرض صور.',
      lead: 'نعرض منتجاتنا وأعمالنا للعملاء كما هي: الواجهات الحقيقية، والمعمارية، والقرارات التي اتخذناها.',
      productTag: 'منتج من نواة',
      clientTag: 'عمل لعميل',
      rihabName: 'رحاب',
      rihabBody: 'سوق رقمي فلسطيني يربط العملاء بالمتاجر والبائعين الفلسطينيين، مع منظومة تشغيل كاملة خلف الواجهة.',
      rihabDomainsL: 'المجالات', rihabDomains: 'السوق · عمليات التجّار · الاتفاقيات · التوصيل · الأتمتة',
      rihabIfaceL: 'الواجهات', rihabIface: 'المتجر · مساحة التاجر · الإدارة · الجوّال',
      mcName: 'Magic Car',
      mcBody: 'منصة B2B للتجّار حول نظام ERP قائم: تجربة تاجر حديثة، وأدوات إدارة، وطبقة تكامل تُبقي النظام القائم مرجعًا.',
      mcDomainsL: 'المجالات', mcDomains: 'التكامل · الكتالوج · الطلبات · الحملات',
      mcPlatL: 'المنصّات', mcPlat: 'Flutter · Web · iOS · Android',
      caseCta: 'اقرأ دراسة الحالة',
      moreTitle: 'مزيد من دراسات الحالة قريبًا',
      moreBody: 'ننشر دراسة الحالة عندما يكتمل توثيقها وتوافق الجهة المالكة على نشرها.',
      startCta: 'ابدأ مشروعك',
      altRihab: 'واجهة سوق رحاب على سطح المكتب',
      altMerchant: 'لوحة تحكم المتجر في رحاب',
      altCarrier: 'ربط مدن ومناطق شركات التوصيل في رحاب',
      altCatalog: 'كتالوج Magic Car', altCart: 'سلة التاجر في Magic Car', altAdmin: 'لوحة إدارة Magic Car',
    }
  : {
      label: 'Work',
      title: 'Work that reads as engineering evidence, not an image gallery.',
      lead: 'We show our products and client work as they are: the real interfaces, the architecture, and the decisions we made.',
      productTag: 'Nawa Product',
      clientTag: 'Client Work',
      rihabName: 'Rihab',
      rihabBody: 'A Palestinian digital marketplace connecting customers with Palestinian shops and vendors, with a full operations system behind the storefront.',
      rihabDomainsL: 'Domains', rihabDomains: 'Marketplace · merchant ops · agreements · delivery · automation',
      rihabIfaceL: 'Interfaces', rihabIface: 'Storefront · merchant space · admin · mobile',
      mcName: 'Magic Car',
      mcBody: 'A B2B trader platform around an existing ERP: a modern trader experience, admin tools, and an integration layer that keeps the existing system authoritative.',
      mcDomainsL: 'Domains', mcDomains: 'Integration · catalog · orders · campaigns',
      mcPlatL: 'Platforms', mcPlat: 'Flutter · Web · iOS · Android',
      caseCta: 'Read the case study',
      moreTitle: 'More case studies soon',
      moreBody: 'We publish a case study once its documentation is complete and the owner has approved it for publication.',
      startCta: 'Start a project',
      altRihab: 'Rihab marketplace storefront on desktop',
      altMerchant: 'Rihab merchant dashboard',
      altCarrier: 'Rihab carrier city and region mapping',
      altCatalog: 'Magic Car catalog', altCart: 'Magic Car trader cart', altAdmin: 'Magic Car admin dashboard',
    };
---

<section class="wi-hero">
  <div class="wrap grid12 wi-hero-inner">
    <div class="wi-hero-l">
      <p class="sec-label">{t.label}</p>
      <h1 class="t-h1">{t.title}</h1>
    </div>
    <div class="wi-hero-r">
      <p class="t-body">{t.lead}</p>
      <div class="wi-tags"><span class="tag-own tag-product">{t.productTag}</span><span class="tag-own tag-client">{t.clientTag}</span></div>
    </div>
  </div>
</section>

<article class="sec wi-rihab" aria-labelledby="w-rihab">
  <div class="wrap-wide grid12 wi-rihab-grid">
    <a href={L('work/rihab')} class="wi-rihab-hero" aria-labelledby="w-rihab">
      <ResponsiveImage basePath="/work/rihab/marketplace-home" alt={t.altRihab} width={2000} height={1008} class="shot" loading="eager" />
    </a>
    <div class="wi-rihab-body">
      <div class="wi-meta"><span class="mono wi-ix">01</span><span class="tag-own tag-product">{t.productTag}</span></div>
      <h2 id="w-rihab" class="t-h2">{t.rihabName}</h2>
      <p class="t-body">{t.rihabBody}</p>
      <dl class="wi-dl">
        <dt class="muted">{t.rihabDomainsL}</dt><dd>{t.rihabDomains}</dd>
        <dt class="muted">{t.rihabIfaceL}</dt><dd>{t.rihabIface}</dd>
      </dl>
      <div class="wi-rihab-thumbs">
        <ResponsiveImage basePath="/work/rihab/merchant-dashboard" alt={t.altMerchant} width={2000} height={1008} class="shot" />
        <ResponsiveImage basePath="/work/rihab/carrier-mapping" alt={t.altCarrier} width={2000} height={1008} class="shot" />
      </div>
      <a href={L('work/rihab')} class="link-t wi-cta">{t.caseCta} <Fragment set:html={arrow} /></a>
    </div>
  </div>
</article>

<article class="sec wi-mc alt" aria-labelledby="w-mc">
  <div class="wrap grid12 wi-mc-grid">
    <div class="wi-mc-body">
      <div class="wi-meta"><span class="mono wi-ix">02</span><span class="tag-own tag-client">{t.clientTag}</span></div>
      <h2 id="w-mc" class="t-h2"><bdi dir="ltr">{t.mcName}</bdi></h2>
      <p class="t-body">{t.mcBody}</p>
      <dl class="wi-dl">
        <dt class="muted">{t.mcDomainsL}</dt><dd>{t.mcDomains}</dd>
        <dt class="muted">{t.mcPlatL}</dt><dd><bdi dir="ltr">{t.mcPlat}</bdi></dd>
      </dl>
      <p class="anno">S3 → Lambda → CloudFront</p>
      <a href={L('work/magic-car')} class="link-t wi-cta">{t.caseCta} <Fragment set:html={arrow} /></a>
    </div>
    <a href={L('work/magic-car')} class="wi-mc-phones" aria-labelledby="w-mc">
      <figure class="p0"><ResponsiveImage basePath="/work/magic-car/product-catalog" alt={t.altCatalog} width={369} height={800} class="shot-phone" /></figure>
      <figure class="p1"><ResponsiveImage basePath="/work/magic-car/cart" alt={t.altCart} width={369} height={800} class="shot-phone" /></figure>
      <figure class="p2"><ResponsiveImage basePath="/work/magic-car/admin-dashboard" alt={t.altAdmin} width={369} height={800} class="shot-phone" /></figure>
    </a>
  </div>
</article>

<section class="sec wi-more">
  <div class="wrap grid12 wi-more-grid">
    <div class="wi-more-l">
      <h2 class="t-h4">{t.moreTitle}</h2>
      <p class="t-sm">{t.moreBody}</p>
    </div>
    <div class="wi-more-r"><a href={L('contact')} class="btn btn-primary">{t.startCta}</a></div>
  </div>
</section>

<style>
  .wi-hero { border-bottom: 1px solid var(--border); }
  .wi-hero-inner { padding-top: 80px; padding-bottom: 64px; align-items: end; row-gap: 24px; }
  .wi-hero-l { grid-column: 1 / span 7; display: flex; flex-direction: column; gap: 20px; }
  .wi-hero-r { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 16px; }
  .wi-tags { display: flex; gap: 10px; flex-wrap: wrap; }

  .wi-rihab-grid { align-items: start; row-gap: 32px; }
  .wi-rihab-hero { grid-column: 1 / span 8; display: block; }
  .wi-rihab-body { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 18px; padding-top: 8px; align-items: flex-start; }
  .wi-meta { display: flex; align-items: center; gap: 12px; }
  .wi-ix { font-size: 12px; color: var(--muted); }
  .wi-dl { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px 16px; font-size: 14px; border-top: 1px solid var(--border); padding-top: 16px; width: 100%; }
  .wi-dl dd { margin: 0; }
  .wi-rihab-thumbs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; width: 100%; }
  .wi-rihab-thumbs :global(.shot) { border-radius: 8px; }

  .wi-mc.alt { background: var(--subtle); border-block: 1px solid var(--border); }
  .wi-mc-grid { align-items: center; row-gap: 32px; }
  .wi-mc-body { grid-column: 1 / span 4; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .wi-mc-phones { grid-column: 6 / span 7; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .wi-mc-phones .p1 { margin-top: 48px; }
  .wi-mc-phones .p2 { margin-top: 96px; }

  .wi-more-grid { align-items: center; row-gap: 24px; }
  .wi-more-l { grid-column: 1 / span 6; display: flex; flex-direction: column; gap: 10px; }
  .wi-more-r { grid-column: 9 / span 4; display: flex; justify-content: flex-end; }

  @media (max-width: 900px) {
    .wi-rihab-grid, .wi-mc-grid { display: flex; flex-direction: column; }
    .wi-mc-body { order: -1; }
    .wi-mc-phones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .wi-more-r { justify-content: flex-start; }
  }
  @media (max-width: 560px) {
    .wi-mc-phones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wi-mc-phones .p2 { display: none; }
    .wi-mc-phones .p1 { margin-top: 40px; }
  }
</style>
