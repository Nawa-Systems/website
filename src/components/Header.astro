---
import Logo from './Logo.astro';
import { navItems } from '../data/site';
import { t, localizedPath, otherLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const strings = t(locale);
const alt = otherLocale(locale);
const altHref = localizedPath(path, alt);

function href(slug: string) {
  return slug === '' ? `/${locale}` : `/${locale}/${slug}`;
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={`/${locale}`} class="site-header__brand" aria-label="Nawa">
      <Logo variant="charcoal" width={32} />
      <span class="site-header__wordmark bidi-isolate">Nawa — نواة</span>
    </a>

    <nav id="site-nav" class="site-header__nav" aria-label={locale === 'ar' ? 'التنقل الرئيسي' : 'Primary navigation'}>
      <ul>
        {navItems.map((item) => {
          const itemHref = href(item.slug);
          const isActive = path === itemHref;
          return (
            <li>
              <a href={itemHref} aria-current={isActive ? 'page' : undefined}>
                {locale === 'ar' ? item.labelAr : item.labelEn}
              </a>
            </li>
          );
        })}
      </ul>
      <a href={altHref} class="site-header__lang site-header__lang--mobile" hreflang={alt} lang={alt}>
        {strings.languageSwitch}
      </a>
    </nav>

    <div class="site-header__actions">
      <a href={altHref} class="site-header__lang site-header__lang--desktop" hreflang={alt} lang={alt}>
        {strings.languageSwitch}
      </a>
      <a href={href('contact')} class="button button-primary">
        {strings.startProject}
      </a>
      <button
        id="nav-toggle"
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={locale === 'ar' ? 'فتح القائمة' : 'Open menu'}
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open');
  });
</script>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-near-black);
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--color-secondary-text);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    padding-block: var(--space-1);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-burgundy);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__lang {
    text-decoration: none;
    color: var(--color-secondary-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    min-height: var(--touch-target);
    display: inline-flex;
    align-items: center;
  }

  .site-header__lang:hover {
    color: var(--color-burgundy);
  }

  .site-header__lang--mobile {
    display: none;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: var(--touch-target);
    height: var(--touch-target);
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    margin-inline: 10px;
    background: var(--color-near-black);
  }

  @media (max-width: 860px) {
    .site-header__nav {
      position: fixed;
      inset: 0;
      top: 64px;
      background: var(--color-canvas);
      padding: var(--space-4);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--motion-base) var(--ease-standard),
        transform var(--motion-base) var(--ease-standard);
    }

    .site-header__nav.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-header__nav ul {
      flex-direction: column;
      gap: var(--space-1);
    }

    .site-header__nav a {
      display: block;
      min-height: var(--touch-target);
      display: flex;
      align-items: center;
      font-size: var(--text-lg);
    }

    .site-header__lang--mobile {
      display: inline-flex;
      margin-top: var(--space-4);
      min-height: var(--touch-target);
      align-items: center;
    }

    .site-header__lang--desktop {
      display: none;
    }

    .site-header__toggle {
      display: flex;
    }
  }
</style>
