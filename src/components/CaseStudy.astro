---
import ResponsiveImage from './ResponsiveImage.astro';

interface ArchitectureBlock {
  heading: string;
  body: string;
}

interface ImageEntry {
  key: string;
  caption: string;
  width: number;
  height: number;
}

interface Props {
  slug: 'rihab' | 'magic-car';
  eyebrow: string;
  title: string;
  summary: string;
  problemTitle: string;
  problem: string;
  constraintsTitle: string;
  constraints: string[];
  decisionsTitle: string;
  decisions: string[];
  architectureTitle: string;
  architecture: ArchitectureBlock[];
  evidenceTitle: string;
  images: ImageEntry[];
  resultTitle: string;
  result: string;
  lessonTitle: string;
  lesson: string;
}

const {
  slug,
  eyebrow,
  title,
  summary,
  problemTitle,
  problem,
  constraintsTitle,
  constraints,
  decisionsTitle,
  decisions,
  architectureTitle,
  architecture,
  evidenceTitle,
  images,
  resultTitle,
  result,
  lessonTitle,
  lesson,
} = Astro.props;
---

<article class="case-study container">
  <header class="case-study__header">
    <p class="case-study__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="case-study__summary">{summary}</p>
  </header>

  <section class="case-study__block">
    <h2>{problemTitle}</h2>
    <p>{problem}</p>
  </section>

  <section class="case-study__block">
    <h2>{constraintsTitle}</h2>
    <ul>
      {constraints.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <section class="case-study__block">
    <h2>{decisionsTitle}</h2>
    <ul>
      {decisions.map((d) => <li>{d}</li>)}
    </ul>
  </section>

  <section class="case-study__block">
    <h2>{architectureTitle}</h2>
    {architecture.map((a) => (
      <div class="case-study__architecture-item">
        <h3>{a.heading}</h3>
        <p>{a.body}</p>
      </div>
    ))}
  </section>

  <section class="case-study__block">
    <h2>{evidenceTitle}</h2>
    <div class="case-study__gallery">
      {images.map((img) => (
        <figure>
          <ResponsiveImage
            basePath={`/work/${slug}/${img.key}`}
            alt={img.caption}
            width={img.width}
            height={img.height}
          />
          <figcaption>{img.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="case-study__block case-study__outcome">
    <div>
      <h2>{resultTitle}</h2>
      <p>{result}</p>
    </div>
    <div>
      <h2>{lessonTitle}</h2>
      <p>{lesson}</p>
    </div>
  </section>
</article>

<style>
  .case-study {
    padding-block: var(--space-7);
    max-width: var(--max-width-content);
  }

  .case-study__header {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-7);
  }

  .case-study__eyebrow {
    color: var(--color-rust);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .case-study__header h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .case-study__summary {
    font-size: var(--text-lg);
    color: var(--color-secondary-text);
  }

  .case-study__block {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    max-width: var(--max-width-prose);
  }

  .case-study__block h2 {
    font-size: var(--text-xl);
    color: var(--color-burgundy);
    margin-bottom: var(--space-3);
  }

  .case-study__block ul {
    padding-inline-start: 1.2em;
  }

  .case-study__block li {
    margin-bottom: var(--space-2);
  }

  .case-study__architecture-item {
    margin-bottom: var(--space-4);
  }

  .case-study__architecture-item h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }

  .case-study__block:has(.case-study__gallery) {
    max-width: none;
  }

  .case-study__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .case-study__gallery figure {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .case-study__gallery img {
    width: 100%;
    height: auto;
  }

  .case-study__gallery figcaption {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-secondary-text);
  }

  .case-study__outcome {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    max-width: none;
  }

  .case-study__outcome > div {
    max-width: var(--max-width-prose);
  }

  @media (max-width: 780px) {
    .case-study__outcome {
      grid-template-columns: 1fr;
    }
  }
</style>
