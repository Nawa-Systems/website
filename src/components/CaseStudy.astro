---
import ResponsiveImage from './ResponsiveImage.astro';
import BrandGeometry from './BrandGeometry.astro';

interface ArchitectureBlock {
  heading: string;
  body: string;
}

interface ImageEntry {
  key: string;
  caption: string;
  width: number;
  height: number;
}

interface Props {
  slug: 'rihab' | 'magic-car';
  eyebrow: string;
  title: string;
  summary: string;
  problemTitle: string;
  problem: string;
  constraintsTitle: string;
  constraints: string[];
  decisionsTitle: string;
  decisions: string[];
  architectureTitle: string;
  architecture: ArchitectureBlock[];
  evidenceTitle: string;
  images: ImageEntry[];
  resultTitle: string;
  result: string;
  lessonTitle: string;
  lesson: string;
}

const {
  slug,
  eyebrow,
  title,
  summary,
  problemTitle,
  problem,
  constraintsTitle,
  constraints,
  decisionsTitle,
  decisions,
  architectureTitle,
  architecture,
  evidenceTitle,
  images,
  resultTitle,
  result,
  lessonTitle,
  lesson,
} = Astro.props;

// Wide architecture diagrams get a full-width breakout; UI screenshots keep
// their intrinsic ratio in an editorial grid. Split by naming convention.
const diagrams = images.filter((img) => img.key.startsWith('diagram-'));
const screens = images.filter((img) => !img.key.startsWith('diagram-'));
---

<article class="case-study container">
  <header class="case-study__header">
    <div class="case-study__header-text">
      <p class="case-study__eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="case-study__summary">{summary}</p>
    </div>
    <BrandGeometry variant="fragment" class="case-study__geo" />
  </header>

  <section class="case-study__block">
    <h2>{problemTitle}</h2>
    <p>{problem}</p>
  </section>

  <section class="case-study__block">
    <h2>{constraintsTitle}</h2>
    <ul>
      {constraints.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <section class="case-study__block">
    <h2>{decisionsTitle}</h2>
    <ul>
      {decisions.map((d) => <li>{d}</li>)}
    </ul>
  </section>

  <section class="case-study__block">
    <h2>{architectureTitle}</h2>
    {architecture.map((a) => (
      <div class="case-study__architecture-item">
        <h3>{a.heading}</h3>
        <p>{a.body}</p>
      </div>
    ))}
  </section>

  <section class="case-study__block case-study__evidence">
    <h2>{evidenceTitle}</h2>

    {screens.length > 0 && (
      <div class="case-study__gallery">
        {screens.map((img) => (
          <figure class:list={['case-study__figure', { 'is-portrait': img.height > img.width }]}>
            <div class="case-study__figure-media">
              <ResponsiveImage
                basePath={`/work/${slug}/${img.key}`}
                alt={img.caption}
                width={img.width}
                height={img.height}
              />
            </div>
            <figcaption>{img.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {diagrams.map((img) => (
      <figure class="case-study__diagram">
        <div class="case-study__diagram-media">
          <ResponsiveImage
            basePath={`/work/${slug}/${img.key}`}
            alt={img.caption}
            width={img.width}
            height={img.height}
          />
        </div>
        <figcaption>{img.caption}</figcaption>
      </figure>
    ))}
  </section>

  <section class="case-study__block case-study__outcome">
    <div>
      <h2>{resultTitle}</h2>
      <p>{result}</p>
    </div>
    <div>
      <h2>{lessonTitle}</h2>
      <p>{lesson}</p>
    </div>
  </section>
</article>

<style>
  .case-study {
    padding-block: var(--space-7);
    max-width: var(--max-width-content);
  }

  .case-study__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .case-study__header-text {
    max-width: var(--max-width-prose);
  }
  .case-study :global(.case-study__geo) {
    flex: none;
    width: 120px;
    margin-top: var(--space-2);
  }
  @media (max-width: 640px) {
    .case-study :global(.case-study__geo) {
      display: none;
    }
  }

  .case-study__eyebrow {
    color: var(--color-rust);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-transform: var(--label-transform);
    letter-spacing: var(--label-tracking);
    margin-bottom: var(--space-2);
  }

  .case-study__header h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .case-study__summary {
    font-size: var(--text-lg);
    color: var(--color-secondary-text);
  }

  .case-study__block {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    max-width: var(--max-width-prose);
  }

  .case-study__block h2 {
    font-size: var(--text-xl);
    color: var(--color-burgundy);
    margin-bottom: var(--space-3);
  }

  .case-study__block ul {
    padding-inline-start: 1.2em;
  }

  .case-study__block li {
    margin-bottom: var(--space-2);
  }

  .case-study__architecture-item {
    margin-bottom: var(--space-4);
  }

  .case-study__architecture-item h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }

  .case-study__evidence {
    max-width: none;
  }

  .case-study__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  .case-study__figure {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  /* Portrait mobile screenshots keep their ratio, centered on a neutral field
     rather than cropped into a landscape tile. */
  .case-study__figure.is-portrait .case-study__figure-media {
    background: var(--color-subtle-surface);
    display: grid;
    place-items: center;
    padding: var(--space-3);
  }
  .case-study__figure.is-portrait :global(img) {
    max-height: 520px;
    width: auto;
  }
  .case-study__figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-study__figure figcaption,
  .case-study__diagram figcaption {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-secondary-text);
  }

  /* Wide architecture diagrams: full-width breakout, kept legible. */
  .case-study__diagram {
    margin: var(--space-5) 0 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .case-study__diagram-media {
    overflow-x: auto;
  }
  .case-study__diagram :global(img) {
    width: 100%;
    min-width: 560px;
    height: auto;
    display: block;
  }

  .case-study__outcome {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    max-width: none;
  }

  .case-study__outcome > div {
    max-width: var(--max-width-prose);
  }

  @media (max-width: 780px) {
    .case-study__outcome {
      grid-template-columns: 1fr;
    }
  }
</style>
