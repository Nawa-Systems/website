<style>
  .arch-title { font-size: 14px; font-weight: 500; color: #faf9f7; }
  .arch-mob { display: none; }
  @media (max-width: 760px) {
    .arch-desk { display: none; }
    .arch-mob { display: flex; flex-direction: column; padding: 20px; }
    .arch-mob .zone { color: #a9acaf; margin-bottom: 8px; }
    .arch-box { border: 1px solid rgba(255,255,255,.22); border-radius: 10px; padding: 12px 14px; background: #2a2c2f; font-size: 14px; color: #faf9f7; }
    .arch-box.dashed { border-style: dashed; border-color: rgba(255,255,255,.3); }
    .arch-box.focal { border: 1.5px solid #d49aaa; }
    .arch-box b { font-weight: 500; font-size: 15px; display: block; }
    .arch-box .t-cap { color: #a9acaf; }
    .arch-pair { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; }
    .arch-conn { display: flex; align-items: stretch; gap: 10px; height: 44px; padding-inline-start: 20px; }
    .arch-conn > span:first-child { width: 1px; background: #7a7f85; }
    .arch-conn.focal > span:first-child { background: #d49aaa; }
    .arch-conn .t-cap { align-self: center; color: #a9acaf; }
    .arch-conn.focal .t-cap { color: #d49aaa; }
  }
</style>
