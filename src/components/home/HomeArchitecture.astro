        <rect x="820" y="24" width="276" height="412" rx="14" fill="#FFFFFF" fill-opacity=".03" stroke="#FFFFFF" stroke-opacity=".12"></rect>
        <text direction="rtl" x="1076" y="52" fill="#A9ACAF" font-size="12" text-anchor="start" style="font-family:'IBM Plex Sans Arabic',sans-serif">النظام القائم</text>
