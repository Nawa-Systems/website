        <path d="M850 128 L750 128" fill="none" stroke="#7A7F85" stroke-width="1.25" marker-end="url(#ahr)"></path>
        <text direction="rtl" x="800" y="118" fill="#A9ACAF" font-size="11" text-anchor="middle" style="font-family:'IBM Plex Sans Arabic',sans-serif">مزامنة</text>
