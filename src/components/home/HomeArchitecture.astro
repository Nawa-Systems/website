        <rect x="370" y="96" width="170" height="64" rx="10" fill="#2A2C2F" stroke="#FFFFFF" stroke-opacity=".22" stroke-width="1"></rect>
        <text direction="rtl" x="524" y="124" fill="#FAF9F7" font-size="14" font-weight="500" text-anchor="start" style="font-family:'IBM Plex Sans Arabic',sans-serif">آخر نسخة سليمة</text>
