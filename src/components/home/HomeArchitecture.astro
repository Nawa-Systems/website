---
// Simplified external architecture for Magic Car: ERP stays authoritative,
// Nawa's integration layer keeps a last-known-good catalog and validates orders
// live. Full detail on a wide SVG (scrolls if needed); stacked on small screens
// so no semantic information is cropped. Coordinates hand-mirrored for RTL.
import { getHomeCopy } from '../../data/homeCopy';
import type { Locale } from '../../lib/i18n';
const { locale } = Astro.props as { locale: Locale };
const isAr = locale === 'ar';
const c = getHomeCopy(locale);
const ariaLabel = isAr
  ? 'معمارية Magic Car: يبقى نظام ERP المرجع المعتمد، وتزامن طبقة التكامل كتالوجًا موثوقًا وتتحقق من الطلبات لحظيًا، ويخدم تطبيق Flutter التجّار.'
  : 'Magic Car architecture: the ERP stays authoritative; Nawa’s integration layer syncs a last-known-good catalog and validates orders live; the Flutter client serves traders.';
---
<figure class="diagram-box arch" data-motion="focal path (burgundy) traces after neutral structure settles">
  <div class="diagram-head">
    <span class="arch-title">{c.noteDiagramTitle}</span>
    <span class="anno">external diagram · v1</span>
  </div>

  <div class="arch-desk">
    {isAr ? (
      <svg viewBox="0 0 1120 460" width="100%" style="display:block;min-width:880px" role="img" aria-label={ariaLabel}>
