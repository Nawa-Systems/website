---
// Small mark-derived concept diagram per service. Decorative (aria-hidden);
// labels are localized. Neutral structure + a single burgundy focal element.
import type { Locale } from '../../lib/i18n';
const { concept, locale } = Astro.props as {
  concept: 'custom' | 'cloud' | 'automation' | 'modernization';
  locale: Locale;
};
const ar = locale === 'ar';
const mono = "font-family:'IBM Plex Mono',monospace";
const sans = "font-family:'IBM Plex Sans Arabic',sans-serif";
---
<div class="svc-concept" aria-hidden="true">
  {concept === 'custom' && (
    <svg viewBox="0 0 320 180" width="100%" style="max-width:320px;display:block">
      <rect x="20" y="20" width="86" height="88" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <rect x="124" y="20" width="48" height="88" rx="10" fill="#fff" stroke="#6E263C" stroke-width="1.5"></rect>
      <rect x="190" y="20" width="110" height="88" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <path d="M63 108V140M245 108V140" stroke="#A9ACAF" stroke-width="1.25"></path>
      <path d="M148 108V140" stroke="#6E263C" stroke-width="1.5"></path>
      <rect x="20" y="140" width="280" height="26" rx="6" fill="#F4F3F0" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <text x="32" y="157" font-size="11" fill="#64686E" style={mono}>api · domain</text>
      {ar ? (<><text x="30" y="40" font-size="10" fill="#64686E" style={sans}>ويب</text><text x="131" y="40" font-size="10" fill="#6E263C" style={sans}>تطبيق</text><text x="200" y="40" font-size="10" fill="#64686E" style={sans}>إدارة</text></>)
         : (<><text x="30" y="40" font-size="10" fill="#64686E" style={mono}>web</text><text x="131" y="40" font-size="10" fill="#6E263C" style={mono}>app</text><text x="200" y="40" font-size="10" fill="#64686E" style={mono}>admin</text></>)}
    </svg>
  )}
  {concept === 'cloud' && (
    <svg viewBox="0 0 320 180" width="100%" style="max-width:320px;display:block">
      <rect x="70" y="12" width="236" height="156" rx="12" fill="#fff" fill-opacity=".6" stroke="#A9ACAF" stroke-dasharray="5 5"></rect>
      <rect x="90" y="44" width="196" height="30" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <rect x="90" y="84" width="196" height="30" rx="8" fill="#fff" stroke="#6E263C" stroke-width="1.5"></rect>
      <rect x="90" y="124" width="196" height="30" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <path d="M14 99H84" stroke="#6E263C" stroke-width="1.5"></path>
      <path d="M80 95l6 4-6 4z" fill="#6E263C"></path>
      <text x="84" y="32" font-size="10" fill="#64686E" style={mono}>{ar ? 'الإنتاج' : 'production'}</text>
      <text x="102" y="63" font-size="10.5" fill="#2A2C2F" style={mono}>edge · cdn</text>
      <text x="102" y="103" font-size="10.5" fill="#6E263C" style={mono}>{ar ? 'الخدمات' : 'services'}</text>
      <text x="102" y="143" font-size="10.5" fill="#2A2C2F" style={mono}>{ar ? 'بيانات · تخزين' : 'data · storage'}</text>
      <text x="14" y="90" font-size="10" fill="#6E263C" style={mono}>ci/cd</text>
    </svg>
  )}
  {concept === 'automation' && (
    <svg viewBox="0 0 320 180" width="100%" style="max-width:320px;display:block">
      <path d="M58 90H74M126 90H142M194 90H210M262 90H276" stroke="#A9ACAF" stroke-width="1.25"></path>
      <rect x="14" y="66" width="44" height="48" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <rect x="74" y="66" width="52" height="48" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <rect x="142" y="66" width="52" height="48" rx="8" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <rect x="210" y="58" width="52" height="64" rx="8" fill="#FAF4F6" stroke="#6E263C" stroke-width="1.5"></rect>
      <rect x="276" y="66" width="32" height="48" rx="8" fill="#2A2C2F"></rect>
      {ar ? (<>
        <text x="22" y="134" font-size="10" fill="#64686E" style={sans}>إدخال</text>
        <text x="80" y="134" font-size="10" fill="#64686E" style={sans}>تحليل</text>
        <text x="146" y="134" font-size="10" fill="#64686E" style={sans}>إثراء</text>
        <text x="214" y="142" font-size="10" fill="#6E263C" style={sans}>مراجعة</text>
        <text x="278" y="134" font-size="10" fill="#64686E" style={sans}>إخراج</text>
      </>) : (<>
        <text x="20" y="134" font-size="10" fill="#64686E" style={mono}>in</text>
        <text x="80" y="134" font-size="10" fill="#64686E" style={mono}>parse</text>
        <text x="146" y="134" font-size="10" fill="#64686E" style={mono}>enrich</text>
        <text x="212" y="142" font-size="10" fill="#6E263C" style={mono}>review</text>
        <text x="278" y="134" font-size="10" fill="#64686E" style={mono}>out</text>
      </>)}
    </svg>
  )}
  {concept === 'modernization' && (
    <svg viewBox="0 0 320 180" width="100%" style="max-width:320px;display:block">
      <rect x="14" y="40" width="104" height="100" rx="10" fill="#fff" stroke="#2A2C2F" stroke-width="1.25" stroke-dasharray="5 4"></rect>
      <rect x="150" y="20" width="156" height="140" rx="12" fill="#fff" stroke="#6E263C" stroke-width="1.5"></rect>
      <rect x="166" y="54" width="124" height="28" rx="7" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <rect x="166" y="92" width="124" height="28" rx="7" fill="#fff" stroke="#2A2C2F" stroke-width="1.25"></rect>
      <path d="M118 70H166M118 108H166" stroke="#A9ACAF" stroke-width="1.25"></path>
      {ar ? (<>
        <text x="26" y="62" font-size="10" fill="#64686E" style={sans}>نظام</text>
        <text x="26" y="76" font-size="10" fill="#64686E" style={sans}>قائم</text>
        <text x="162" y="40" font-size="10" fill="#6E263C" style={sans}>طبقة التكامل</text>
        <text x="176" y="72" font-size="10" fill="#2A2C2F" style={mono}>sync · cache</text>
        <text x="176" y="110" font-size="10" fill="#2A2C2F" style={mono}>validate · api</text>
      </>) : (<>
        <text x="26" y="62" font-size="10" fill="#64686E" style={mono}>existing</text>
        <text x="26" y="76" font-size="10" fill="#64686E" style={mono}>system</text>
        <text x="162" y="40" font-size="10" fill="#6E263C" style={mono}>integration layer</text>
        <text x="176" y="72" font-size="10" fill="#2A2C2F" style={mono}>sync · cache</text>
        <text x="176" y="110" font-size="10" fill="#2A2C2F" style={mono}>validate · api</text>
      </>)}
    </svg>
  )}
</div>
<style>.svc-concept { margin-top: 12px; }</style>
