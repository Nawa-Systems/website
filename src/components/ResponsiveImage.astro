---
interface Props {
  basePath: string; // e.g. /work/rihab/marketplace-home (no extension)
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { basePath, alt, width, height, class: className = '', loading = 'lazy' } = Astro.props;
---

<picture>
  <source srcset={`${basePath}.avif`} type="image/avif" />
  <source srcset={`${basePath}.webp`} type="image/webp" />
  <img
    src={`${basePath}.jpg`}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={loading}
    decoding="async"
  />
</picture>
