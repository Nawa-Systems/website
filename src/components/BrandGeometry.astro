---
// Nawa-native decorative geometry, derived from the mark rather than repeating it.
// The mark is two charcoal architectural blades + a burgundy nucleus; here that
// becomes modular vertical forms (softened corners, a subtle architectural lean),
// a nucleus, and thin system-flow connectors with restrained nodes.
//
// Decorative only: aria-hidden, no semantic content. Variants:
//   system   — hero composition: modules + nucleus + flow to a production node
//   fragment — a single large thin-line blade for section framing / watermark
interface Props {
  variant?: 'system' | 'fragment';
  class?: string;
}
const { variant = 'system', class: className } = Astro.props;
---

{variant === 'system' && (
  <svg
    class:list={['brand-geo', 'brand-geo--system', className]}
    viewBox="0 0 320 360"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    {/* faint alignment guides */}
    <line class="geo-guide" x1="40" y1="20" x2="40" y2="340" />
    <line class="geo-guide" x1="20" y1="300" x2="300" y2="300" />

    {/* modular blade forms (softened corners + architectural lean) */}
    <g class="geo-modules">
      <rect class="geo-blade geo-blade--outline" x="52" y="96" width="70" height="176" rx="16" />
      <rect class="geo-blade geo-blade--fill" x="140" y="60" width="70" height="212" rx="16" />
      <rect class="geo-blade geo-blade--outline geo-blade--short" x="150" y="196" width="58" height="76" rx="14" />
    </g>

    {/* thin system-flow connectors + nodes */}
    <g class="geo-flow">
      <path class="geo-path" d="M122 150 L176 150" />
      <path class="geo-path geo-path--dashed" d="M210 166 C250 166 258 232 258 300" />
      <path class="geo-path" d="M210 234 L258 234" />
      <circle class="geo-node" cx="122" cy="150" r="4" />
      <circle class="geo-node" cx="210" cy="234" r="4" />
      <circle class="geo-node geo-node--prod" cx="258" cy="300" r="6" />
    </g>

    {/* burgundy nucleus — the core */}
    <circle class="geo-nucleus" cx="228" cy="78" r="17" />
  </svg>
)}

{variant === 'fragment' && (
  <svg
    class:list={['brand-geo', 'brand-geo--fragment', className]}
    viewBox="0 0 240 320"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <rect class="geo-blade geo-blade--outline" x="40" y="40" width="96" height="300" rx="22" />
    <rect class="geo-blade geo-blade--outline" x="150" y="-20" width="96" height="300" rx="22" />
    <circle class="geo-nucleus" cx="206" cy="30" r="20" />
  </svg>
)}

<style>
  .brand-geo {
    display: block;
    width: 100%;
    height: auto;
    /* clip to the viewBox so decorative geometry can never cause page overflow */
    overflow: hidden;
  }

  .geo-guide {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .geo-blade {
    /* subtle architectural lean echoing the mark, from the blade's own base */
    transform: skewY(-6deg);
    transform-origin: center;
    transform-box: fill-box;
  }
  .geo-blade--outline {
    stroke: var(--color-deep-charcoal);
    stroke-width: 2;
    fill: none;
  }
  .geo-blade--fill {
    fill: var(--color-subtle-surface);
    stroke: var(--color-deep-charcoal);
    stroke-width: 2;
  }
  .geo-blade--short {
    stroke: var(--color-border);
  }

  .geo-path {
    stroke: var(--color-secondary-text);
    stroke-width: 1.5;
  }
  .geo-path--dashed {
    stroke-dasharray: 4 5;
  }
  .geo-node {
    fill: var(--color-surface);
    stroke: var(--color-secondary-text);
    stroke-width: 1.5;
  }
  .geo-node--prod {
    fill: var(--color-rust);
    stroke: none;
  }
  .geo-nucleus {
    fill: var(--color-burgundy);
  }

  .brand-geo--fragment {
    opacity: 0.5;
  }
  .brand-geo--fragment .geo-blade--outline {
    stroke: var(--color-border);
    stroke-width: 2;
  }

  /* Gentle one-time entrance; reduced-motion users see the final state at once */
  @media (prefers-reduced-motion: no-preference) {
    .brand-geo--system .geo-blade {
      opacity: 0;
      animation: geo-fade 0.5s var(--ease-standard) forwards;
    }
    .brand-geo--system .geo-blade--fill { animation-delay: 0.08s; }
    .brand-geo--system .geo-blade--short { animation-delay: 0.16s; }

    .brand-geo--system .geo-path {
      stroke-dasharray: 120;
      stroke-dashoffset: 120;
      animation: geo-draw 0.6s var(--ease-standard) 0.24s forwards;
    }
    .brand-geo--system .geo-node,
    .brand-geo--system .geo-nucleus {
      opacity: 0;
      animation: geo-fade 0.4s var(--ease-standard) forwards;
    }
    .brand-geo--system .geo-node { animation-delay: 0.5s; }
    .brand-geo--system .geo-nucleus { animation-delay: 0.32s; }
  }

  @keyframes geo-fade {
    to { opacity: 1; }
  }
  @keyframes geo-draw {
    to { stroke-dashoffset: 0; }
  }
</style>
